    line-height: 30px;
    font-weight: 800;
}

QPushButton:hover {
    background: qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:1, stop:0 #848484, stop:0.05 #848484, stop:0.5 #ebf5ff, stop:0.95 #848484, stop:1 #848484); /* Dark orange gradient when hovering */
