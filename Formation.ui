      <property name="styleSheet">
       <string notr="true">QPushButton {
    background-color: transparent;
    border: none;
 outline: 0;
    text-align: center;
    border: 2px solid transparent; /* Invisible border */
    border-radius: 10px;
    padding: 5px;
    min-width: 70px;
    color: #000;  
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);  
	    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgb(170, 0, 0), stop:0.05 rgb(170, 0, 0), stop:0.5 #000, stop:0.95 rgb(170, 0, 0), stop:1 rgb(170, 0, 0));
	color: rgb(255, 0, 0);
}


QPushButton:pressed {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgb(170, 0, 0), stop:0.05 rgb(170, 0, 0), stop:0.5 #000, stop:0.95 rgb(170, 0, 0), stop:1 rgb(170, 0, 0));
	color: rgb(255, 0, 0);
}</string>
